# Copy to .env and adjust values.
# Loaded by python-decouple (Django) and Docker Compose.
#
# Usage:
#   Local:              cp .env.example .env  →  docker compose up --build
#   Production:         set production values and run the image directly

# =============================================================================
# Django core
# =============================================================================

# config.settings.development is the local default.
# config.settings.production is selected by the production image.
DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Local development. These URLs are for running Django from the host; Compose
# overrides the hostnames for the web container.
# =============================================================================

DATABASE_URL=postgresql://music:music@localhost:5432/music_db

# =============================================================================
# Docker Compose host port mappings
# =============================================================================

WEB_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
